{
  "name": "krishna-companion",
  "version": "0.9.0",
  "description": "A quiet Bhagavad-gītā As It Is companion for long terminal sessions.",
  "main": "src/main.js",
  "homepage": "https://github.com/deepkanchalia/krishna-companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepkanchalia/krishna-companion.git"
  },
  "bugs": {
    "url": "https://github.com/deepkanchalia/krishna-companion/issues"
  },
  "bin": {
    "krshna": "bin/krshna.js",
    "krishna": "bin/krshna.js"
  },
  "files": [
    "bin",
    "src",
    "shell",
    "assets",
    "helpers",
    "!helpers/listen",
    "data/gita.json",
    "data/gita.manifest.json",
    "scripts",
    "!scripts/darshan-preview",
    "!scripts/preview-darshan.js",
    "!scripts/record-darshan.js",
    "docs",
    "!docs/evidence",
    "!docs/media",
    "!docs/claude-adversarial-review.txt",
    "!scripts/anim",
    "!scripts/review-with-claude.sh",
    "!assets/anim/manifest.json",
    "!assets/anim/*/manifest.json",
    "LICENSE-ASSETS.md"
  ],
  "scripts": {
    "start": "electron .",
    "live": "node bin/krshna.js live",
    "demo": "electron . --demo",
    "preview": "electron . --demo --screenshot",
    "fetch": "node scripts/fetch-vedabase.js",
    "lint": "eslint .",
    "review:claude": "bash scripts/review-with-claude.sh",
    "build:helper": "bash scripts/build-helper.sh",
    "postinstall": "node -e \"try{require.resolve('@electron/rebuild')}catch{process.exit(0)};require('child_process').execFileSync('electron-rebuild',['-f','-w','uiohook-napi'],{stdio:'inherit'})\"",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=79 --test-coverage-functions=82"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "bhagavad-gita",
    "bhaktivedanta",
    "focus",
    "desktop-companion",
    "electron"
  ],
  "author": "Deep Kanchalia",
  "license": "MIT",
  "dependencies": {
    "electron": "^44.3.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "^17.12.0"
  }
}
