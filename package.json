{
  "name": "krishna-companion",
  "version": "0.2.0",
  "description": "A quiet Bhagavad-gītā As It Is companion for long terminal sessions.",
  "main": "src/main.js",
  "bin": {
    "krshna": "bin/krshna.js",
    "krishna": "bin/krshna.js"
  },
  "files": [
    "bin",
    "src",
    "shell",
    "assets",
    "!assets/candidates",
    "helpers",
    "!helpers/listen",
    "data/gita.json",
    "scripts",
    "!scripts/darshan-preview",
    "!scripts/preview-darshan.js",
    "docs",
    "!docs/evidence",
    "!experiments",
    "!scripts/anim",
    "!assets/anim/manifest.json",
    "!assets/anim/*/manifest.json"
  ],
  "scripts": {
    "start": "electron .",
    "live": "node bin/krshna.js live",
    "demo": "electron . --demo",
    "preview": "electron . --demo --screenshot",
    "fetch": "node scripts/fetch-vedabase.js",
    "review:claude": "bash scripts/review-with-claude.sh",
    "build:helper": "bash scripts/build-helper.sh",
    "postinstall": "node -e \"try{require.resolve('@electron/rebuild')}catch{process.exit(0)};require('child_process').execFileSync('electron-rebuild',['-f','-w','uiohook-napi'],{stdio:'inherit'})\"",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bhagavad-gita",
    "bhaktivedanta",
    "focus",
    "desktop-companion",
    "electron"
  ],
  "author": "Deep Kanchalia",
  "license": "MIT",
  "licenseNotes": "MIT covers the software only. See LICENSE for text and artwork not covered by MIT.",
  "dependencies": {
    "electron": "^44.2.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.2"
  }
}
